{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image"
    },
    "_meta": {
      "title": "Load Text Encoder (Qwen3-VL 8B)"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    },
    "_meta": {
      "title": "Load RGBA VAE"
    }
  },
  "lora_1": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "lora_name": "qwen-image-2.1-fix-1.0-comfy.safetensors",
      "strength_model": 1.0
    },
    "_meta": {
      "title": "LoRA 1: qwen-image-2.1-fix-1.0-comfy.safetensors"
    }
  },
  "apg": {
    "class_type": "APG",
    "inputs": {
      "model": [
        "lora_1",
        0
      ],
      "eta": 1.0,
      "norm_threshold": 10.0,
      "momentum": 0.3
    },
    "_meta": {
      "title": "APG (adaptive projected guidance)"
    }
  },
  "fresca": {
    "class_type": "FreSca",
    "inputs": {
      "model": [
        "apg",
        0
      ],
      "scale_low": 1.0,
      "scale_high": 2.0,
      "freq_cutoff": 8
    },
    "_meta": {
      "title": "FreSca"
    }
  },
  "encode": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "prompt": "A small corner bookstore at dusk, warm window light, a chalkboard sign reading \"New Arrivals\" in neat hand lettering, wet cobblestones reflecting the glow, 35mm photo, shallow depth of field",
      "negative_prompt": "artifacts, gpt-image, washed-out colors, low quality, low resolution, AI slop, deviantart, sloppy lines, rough sketch, blurry, indistinct, missing fingers, badly drawn hands, wrong number of fingers"
    },
    "_meta": {
      "title": "Text Encode Qwen Image 2.1"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1184,
      "height": 1600,
      "batch_size": 1
    },
    "_meta": {
      "title": "Empty latent (canvas)"
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "fresca",
        0
      ],
      "seed": 42,
      "steps": 20,
      "cfg": 3.0,
      "sampler_name": "seeds_2",
      "scheduler": "sgm_uniform",
      "positive": [
        "encode",
        0
      ],
      "negative": [
        "encode",
        1
      ],
      "latent_image": [
        "latent",
        0
      ],
      "denoise": 1.0
    },
    "_meta": {
      "title": "KSampler"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "_meta": {
      "title": "VAE Decode (RGBA aware)"
    }
  },
  "save": {
    "class_type": "SaveImageAdvanced",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "Qwen_image_2.1",
      "format": "png",
      "format.bit_depth": "8-bit",
      "format.input_color_space": "sRGB"
    },
    "_meta": {
      "title": "Save PNG (keeps alpha)"
    }
  }
}