{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image"
    },
    "_meta": {
      "title": "Load Text Encoder (Qwen3-VL 8B)"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    },
    "_meta": {
      "title": "Load RGBA VAE"
    }
  },
  "cn_patch": {
    "class_type": "ModelPatchLoader",
    "inputs": {
      "name": "qwen_image_2.1_fun_controlnet_union_int8_convrot.safetensors"
    },
    "_meta": {
      "title": "Load Fun ControlNet Union"
    }
  },
  "cn_image": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "qwen21/depth_map.png"
    },
    "_meta": {
      "title": "Control map"
    }
  },
  "controlnet": {
    "class_type": "ZImageFunControlnet",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "model_patch": [
        "cn_patch",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "strength": 0.8,
      "start_percent": 0.0,
      "end_percent": 0.8,
      "image": [
        "cn_image",
        0
      ]
    },
    "_meta": {
      "title": "Apply Fun ControlNet (Qwen 2.1)"
    }
  },
  "encode": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "prompt": "A small corner bookstore at dusk, warm window light, a chalkboard sign reading \"New Arrivals\" in neat hand lettering, wet cobblestones reflecting the glow, 35mm photo, shallow depth of field",
      "negative_prompt": ""
    },
    "_meta": {
      "title": "Text Encode Qwen Image 2.1"
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_meta": {
      "title": "Empty latent (canvas)"
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "controlnet",
        0
      ],
      "seed": 42,
      "steps": 25,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "encode",
        0
      ],
      "negative": [
        "encode",
        1
      ],
      "latent_image": [
        "latent",
        0
      ],
      "denoise": 1.0
    },
    "_meta": {
      "title": "KSampler"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "_meta": {
      "title": "VAE Decode (RGBA aware)"
    }
  },
  "save": {
    "class_type": "SaveImageAdvanced",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "Qwen_image_2.1",
      "format": "png",
      "format.bit_depth": "8-bit",
      "format.input_color_space": "sRGB"
    },
    "_meta": {
      "title": "Save PNG (keeps alpha)"
    }
  }
}