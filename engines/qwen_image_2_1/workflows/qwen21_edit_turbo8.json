{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": {
      "title": "Load Diffusion Model"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image"
    },
    "_meta": {
      "title": "Load Text Encoder (Qwen3-VL 8B)"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    },
    "_meta": {
      "title": "Load RGBA VAE"
    }
  },
  "accel_lora": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "lora_name": "turbo8_lora_step2500.safetensors",
      "strength_model": 1.0
    },
    "_meta": {
      "title": "Accelerator LoRA: Turbo8 — 8 steps, no CFG (recommended for iteration)"
    }
  },
  "model_sampling": {
    "class_type": "ModelSamplingFlux",
    "inputs": {
      "model": [
        "accel_lora",
        0
      ],
      "max_shift": 0.6935,
      "base_shift": 0.5,
      "width": 1024,
      "height": 1024
    },
    "_meta": {
      "title": "ModelSamplingFlux (accelerator shift)"
    }
  },
  "ref_1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "qwen21/product.png"
    },
    "_meta": {
      "title": "Reference image_1"
    }
  },
  "encode": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "prompt": "Remove the background, and output a PNG image",
      "negative_prompt": "",
      "vae": [
        "vae",
        0
      ],
      "resolution": 1024,
      "images.image_1": [
        "ref_1",
        0
      ]
    },
    "_meta": {
      "title": "Text Encode Qwen Image 2.1"
    }
  },
  "sample": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "model_sampling",
        0
      ],
      "seed": 42,
      "steps": 8,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "encode",
        0
      ],
      "negative": [
        "encode",
        1
      ],
      "latent_image": [
        "encode",
        2
      ],
      "denoise": 1.0
    },
    "_meta": {
      "title": "KSampler"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sample",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    },
    "_meta": {
      "title": "VAE Decode (RGBA aware)"
    }
  },
  "save": {
    "class_type": "SaveImageAdvanced",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "Qwen_image_2.1",
      "format": "png",
      "format.bit_depth": "8-bit",
      "format.input_color_space": "sRGB"
    },
    "_meta": {
      "title": "Save PNG (keeps alpha)"
    }
  }
}