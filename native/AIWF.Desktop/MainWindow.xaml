<?xml version="1.0" encoding="utf-8"?>
<!--
  Main window: custom title bar (app name + project picker) over a Mica backdrop, task-based navigation on
  the left, and a content frame. Engine status lives in the footer of the navigation pane.
-->
<Window
    x:Class="AiwfDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AiwfDesktop"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AIWF Studio">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- title bar: draggable area with the app name; the project picker sits on the right.
             The right padding keeps clear of the minimize / maximize / close buttons. The picker lives in
             the star column, so on a narrow window it shrinks (its text trims) instead of sliding under
             those buttons; the subtitle is dropped first (see AppTitleBar_SizeChanged). -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,140,0" ColumnSpacing="12" SizeChanged="AppTitleBar_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="AIWF Studio" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleSubtitle" Text="local AI workstation" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" VerticalAlignment="Center" />
            </StackPanel>
            <Grid Grid.Column="1" ColumnSpacing="8" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="400">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE8B7;" FontSize="14" Opacity="0.75" VerticalAlignment="Center" />
                <ComboBox x:Name="ProjectPicker" Grid.Column="1" MinWidth="120" HorizontalAlignment="Stretch" PlaceholderText="Choose a project"
                          VerticalAlignment="Center" AutomationProperties.Name="Current project" SelectionChanged="ProjectPicker_SelectionChanged" />
            </Grid>
        </Grid>

        <!-- Auto: full labels when the window is wide (1008+), icons only when it is medium, a menu
             button when it is narrow, so small screens keep their width for the page itself -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            OpenPaneLength="232"
            SelectionChanged="Nav_SelectionChanged"
            DisplayModeChanged="Nav_DisplayModeChanged"
            PaneOpening="Nav_PaneOpening"
            PaneClosing="Nav_PaneClosing">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" AutomationProperties.Name="Home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="Create" Tag="create">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Chat" Tag="chat">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Datasets" Tag="datasets">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Train" Tag="train">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Projects" Tag="projects">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- footer: live GPU telemetry. The full version (name, labelled memory and load meters) shows
                 when the pane is open; a closed icon-only pane gets one GPU icon whose tooltip holds the same
                 numbers, so the rail keeps its task icons instead of wrapping text one letter per line -->
            <NavigationView.PaneFooter>
                <Grid>
                <Grid x:Name="FooterCompact" Visibility="Collapsed" Width="48" Padding="0,8,0,12"
                      ToolTipService.ToolTip="GPU telemetry" AutomationProperties.Name="GPU telemetry">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                        <TextBlock x:Name="FooterCompactText" Text="--" Style="{StaticResource CaptionTextBlockStyle}"
                                   HorizontalAlignment="Center" TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="FooterFull" Padding="16,8,16,12" Spacing="4">
                    <TextBlock x:Name="FooterGpu" Text="GPU: reading..." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="FooterVramLabel" Text="Video memory: reading..." Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="FooterVram" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False"
                                 Foreground="#4CC2FF" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" FlowDirection="LeftToRight"
                                 AutomationProperties.Name="GPU memory in use" />
                    <TextBlock x:Name="FooterLoadLabel" Text="GPU load: reading..." Style="{StaticResource CaptionTextBlockStyle}" />
                    <ProgressBar x:Name="FooterLoad" Minimum="0" Maximum="100" Value="0" IsIndeterminate="False"
                                 Foreground="#4CC2FF" Background="{ThemeResource ControlStrongFillColorDefaultBrush}" FlowDirection="LeftToRight"
                                 AutomationProperties.Name="GPU processing load" />
                </StackPanel>
                </Grid>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" Background="{ThemeResource LayerFillColorDefaultBrush}" />
        </NavigationView>
    </Grid>
</Window>
