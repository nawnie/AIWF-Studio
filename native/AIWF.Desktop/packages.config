<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet packages for the native app. Windows App SDK 1.7 is the newest single-package line
     (1.8 and 2.x split into many component packages that packages.config would have to list by hand). -->
<packages>
  <package id="Microsoft.WindowsAppSDK" version="1.7.260224002" targetFramework="native" />
  <package id="Microsoft.Windows.SDK.BuildTools" version="10.0.26100.9169" targetFramework="native" />
  <package id="Microsoft.Web.WebView2" version="1.0.2903.40" targetFramework="native" />
  <package id="Microsoft.Windows.CppWinRT" version="2.0.250303.1" targetFramework="native" />
  <package id="Microsoft.Windows.ImplementationLibrary" version="1.0.250325.1" targetFramework="native" />
</packages>
